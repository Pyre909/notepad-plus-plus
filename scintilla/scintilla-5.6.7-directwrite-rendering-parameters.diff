+// Whether SCI_SETFONTRENDERINGPARAMETER accepts a value for a parameter
+constexpr bool ValidFontRenderingValue(FontRenderingParameter parameter, sptr_t value) noexcept {
+	if (value == FontRenderingDefault) {
+		return true;
+	}
+	switch (parameter) {
+	case FontRenderingParameter::Gamma:
+		// Thousandths like SPI_GETFONTSMOOTHINGCONTRAST
+		return value >= 1000 && value <= 2200;
+	case FontRenderingParameter::EnhancedContrast:
+	case FontRenderingParameter::GrayscaleEnhancedContrast:
+		// Hundredths
+		return value >= 0 && value <= 1000;
+	case FontRenderingParameter::ClearTypeLevel:
+		// Percent
